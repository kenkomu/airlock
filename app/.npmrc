auto-install-peers=true

# @starkware-libs/* (the STRK20 pool SDK) is published to GitHub Packages, not
# npmjs.org, and GitHub Packages requires authentication even for a public read.
#
# pnpm deliberately does NOT expand ${ENV} in credential lines from a committed
# .npmrc — a committed file could point a token at an attacker-controlled
# registry — so the token has to live in a trusted, uncommitted config. Set it
# once, per machine:
#
#   npm config set "//npm.pkg.github.com/:_authToken" "$(gh auth token)"
#
# The token needs the `read:packages` scope; `gh auth refresh -s read:packages`
# adds it to an existing login. CI writes the same line from a repository
# secret. No token is ever committed here.
@starkware-libs:registry=https://npm.pkg.github.com
